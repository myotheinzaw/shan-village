# Supabase project — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_ and never import into a client
# component: this key bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/create-admin.mjs to create the first Owner account.
SETUP_ADMIN_EMAIL=owner@example.com
SETUP_ADMIN_PASSWORD=
SETUP_ADMIN_NAME=Owner

# Public site URL, used in password-reset emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000
