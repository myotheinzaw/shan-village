# Supabase project — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never prefix with NEXT_PUBLIC_ and never import into a client
# component: this key bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/create-admin.mjs to create the first Owner account.
SETUP_ADMIN_EMAIL=owner@example.com
SETUP_ADMIN_PASSWORD=
SETUP_ADMIN_NAME=Owner

# Public site URL, used in password-reset emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Drive — where the daily wastage workbook is published.
#
# Create a service account in Google Cloud, enable the Drive API, download its
# JSON key, then SHARE the Drive folder with the service account's email as an
# Editor. Without that share, Drive answers "File not found" for a folder that
# plainly exists. Full walkthrough in docs/WASTAGE.md.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=wastage-report@your-project.iam.gserviceaccount.com
# The `private_key` field from the JSON key. Keep the \n escapes and the quotes,
# or paste a base64 encoding of the whole key instead.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Fallback used only when the wastage_drive_folder_id setting is blank.
GOOGLE_DRIVE_WASTAGE_FOLDER_ID=1N-185axMNfrq49iXSlLTH1iF-mo15uRy

# Shared secret for the scheduled republish at /api/cron/wastage. Generate one
# with `openssl rand -base64 32`. Without it the endpoint refuses to run.
CRON_SECRET=
